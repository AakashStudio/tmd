# ==========================================
# TMD — The Match Date: Environment Configuration
# ==========================================

# 1. Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tmd_db?schema=public"

# 2. Application & Regional Settings
# Timezone for fixed 12-hour swipe window alignment (e.g. 00:00-12:00 and 12:00-24:00 local time)
APP_TIMEZONE="Asia/Kolkata"

# 3. Session & Security
# Cryptographic secret for signing session cookies (minimum 32 characters in production)
SESSION_SECRET="tmd_super_secret_dev_session_key_32_chars_min!"

# 4. View Once Media Security Parameters (Infrastructure Layer)
# Duration (in seconds) that temporary single-use signed media stream access remains valid
VIEW_ONCE_TOKEN_TTL_SECONDS=60
# Duration (in hours) after which an unopened view-once media attachment expires
VIEW_ONCE_UNOPENED_EXPIRY_HOURS=72
# Private file storage root path for photos and view-once media
MEDIA_STORAGE_PATH="./storage/private_media"

# 5. Razorpay Payments (Manual Subscription Checkout)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# 6. Environment
NODE_ENV="development"
